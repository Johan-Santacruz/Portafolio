# Cabeceras de caché para Cloudflare Pages (y Netlify).
# Los archivos de /assets/ llevan hash en el nombre: se pueden cachear para
# siempre. El resto cambia sin cambiar de nombre, así que va a una semana.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800

/imagenes/*
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: public, max-age=0, must-revalidate
